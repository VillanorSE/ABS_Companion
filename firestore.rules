rules_version = '2';
// Paste these into Firebase console > Firestore Database > Rules, then Publish.
//
// campaigns/{code}/corps/{corpId}: one document per corporation in an online campaign.
//   Anyone signed in (anonymously or with Google) who knows the campaign code can read it,
//   but only the account that created a corporation's document can change or delete it.
//   Campaign codes themselves can't be listed.
// users/{uid}/backup/{doc}: a player's cloud backup, readable and writable only by them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /campaigns/{code}/corps/{corpId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 200000;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /users/{uid}/backup/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
  }
}
